pkgname=rapid-photo-downloader
foldername=rapid_photo_downloader
pkgver=0.9.37
pkgrel=3
pkgdesc="Photo and video downloader"
arch=('any')
url="https://www.damonlynch.net/rapid/"
license=('GPL3')
depends=('desktop-file-utils' 'gstreamer' 'hicolor-icon-theme' 'libgexiv2' 'libnotify' 'python-arrow'
         'perl-image-exiftool' 'python-colour' 'python-dateutil' 'python-easygui' 'python-gobject'
         'python-gphoto2' 'python-psutil' 'python-pymediainfo' 'python-pyqt5' 'python-pyzmq'
         'python-requests' 'python-setuptools' 'python-sortedcontainers' 'python-babel'
         'python-tornado' 'python-pyxdg' 'qt5-imageformats' 'udisks2' 'python-tenacity' 'qt5-svg'
         'python-show-in-file-manager')
makedepends=('intltool' 'ifuse' 'python-hatch' 'python-installer')
optdepends=('ifuse: for iOS devices')
#changelog=$pkgname.changelog

source=(https://github.com/damonlynch/rapid-photo-downloader/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz{,.asc})
sha256sums=('2545253b852b7c92d9732b5ace5e4aae5ca390a774b76828bad8b49468fcedea'
            'SKIP')
validpgpkeys=('E26048A9F4A803B91CB1BD648005B1F36970BE28') # Damon Lynch <damonlynch@gmail.com>

build() {
  mv ${srcdir}/${foldername}-${pkgver} ${srcdir}/${pkgname}-${pkgver}
  cd "${srcdir}"/$pkgname-$pkgver

  hatch build -t wheel
}

package() {
  cd "${srcdir}"/$pkgname-$pkgver
  python -m installer --destdir="${pkgdir}" dist/*.whl

  # move the desktop file, locale and man to the correct locations
  mv ${pkgdir}/usr/lib/python*/site-packages/share ${pkgdir}/usr/share/
  mv ${pkgdir}/usr/lib/python*/site-packages/raphodo/locale ${pkgdir}/usr/share/locale/
  install -d ${pkgdir}/usr/share/man/
  mv ${pkgdir}/usr/lib/python*/site-packages/man ${pkgdir}/usr/share/man/man1/

  # install the icons
  install -Dm644 "data/icons/16x16/apps/rapid-photo-downloader.png" "${pkgdir}/usr/share/icons/hicolor/16x16/apps/rapid-photo-downloader.png"
  install -Dm644 "data/icons/22x22/apps/rapid-photo-downloader.png" "${pkgdir}/usr/share/icons/hicolor/22x22/apps/rapid-photo-downloader.png"
  install -Dm644 "data/icons/24x24/apps/rapid-photo-downloader.png" "${pkgdir}/usr/share/icons/hicolor/24x24/apps/rapid-photo-downloader.png"
  install -Dm644 "data/icons/48x48/apps/rapid-photo-downloader.png" "${pkgdir}/usr/share/icons/hicolor/48x48/apps/rapid-photo-downloader.png"
  install -Dm644 "data/icons/64x64/apps/rapid-photo-downloader.png" "${pkgdir}/usr/share/icons/hicolor/64x64/apps/rapid-photo-downloader.png"
  install -Dm644 "data/icons/128x128/apps/rapid-photo-downloader.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/rapid-photo-downloader.png"
  install -Dm644 "data/icons/256x256/apps/rapid-photo-downloader.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/rapid-photo-downloader.png"
  install -Dm644 "data/icons/512x512/apps/rapid-photo-downloader.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/rapid-photo-downloader.png"
  install -Dm644 "data/icons/scalable/apps/rapid-photo-downloader.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/rapid-photo-downloader.svg"

}
